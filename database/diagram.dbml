//// Tables

Table project {
  id int [pk, not null, increment]
  name varchar
  
  created_at datetime [not null, default: `now()`]
  last_synced_at datetime
  status varchar [not null]

  github_repository_id bigint [unique]
  repository_owner varchar [not null]
  repository_name varchar [not null]
  clone_protocol varchar [not null, default: 'https']
  shallow_clone boolean [not null, default: false]

  selected_version_id int [unique]

  indexes {
    (repository_owner, repository_name) [unique]
  }
}

Table project_version {
  id int [pk, not null, increment]
  project_id int [not null]

  branch varchar
  commit_hash varchar

  analysis_status varchar [not null]
  analyzed_at datetime

  indexes {
    (project_id, commit_hash) [unique]
  }
}

Table evaluation {
  id int [pk, not null, increment]
  project_version_id int [not null]

  type varchar [not null]

  created_at datetime [not null, default: `now()`]
  started_at datetime
  finished_at datetime
}

Table task {
  id int [pk, not null, increment]
  project_id int [not null]
  description varchar
  command varchar
  status varchar [not null]
  kind varchar [not null, default: 'unknown']
  exit_code int
  log_trail varchar
}

Table agent_execution {
  id int [pk, not null, increment]
  evaluation_id int
  agent_type varchar [not null]
  status varchar [not null]
  created_at datetime [not null, default: `now()`]
  started_at datetime
  finished_at datetime
  input_tokens int
  output_tokens int
  estimated_tokens int
  interruption_reason varchar
  error text
  result text
  configuration_snapshot text
  invocation_receipts text [not null, default: '[]']
}

Table ai_provider {
  id int [pk, not null, increment]
  name varchar [not null]
}

Table ai_credential {
  id int [pk, not null, increment]
  ai_provider_id int [not null]

  name varchar [not null]
  api_key varchar [not null]
  revision int [not null, default: 1]
}

Table ai_model {
  id int [pk, not null, increment]
  ai_provider_id int [not null]
  name varchar [not null]
  revision int [not null, default: 1]
}

Table agent_settings {
  agent_type varchar [pk, not null]
  catalog_declared boolean [not null, default: false]
  catalog_name varchar
  catalog_role varchar
  requires_model boolean [not null, default: false]
  model_configuration_agent_type varchar
  execution_modes text [not null, default: '[]']
  quality_attributes text [not null, default: '[]']
  workflow_ids text [not null, default: '[]']
  availability varchar [not null, default: 'not_executed']

  ai_model_id int
  ai_credential_id int

  temperature decimal
  max_tokens int
  token_budget int
  absolute_token_limit int
  verification_fingerprint varchar
  verification_checked_at datetime
  verification_error text
}

Table agent_hierarchy {
  parent_agent_type varchar [not null]
  child_agent_type varchar [not null]
  indexes {
    (parent_agent_type, child_agent_type) [pk]
    child_agent_type
  }
}

Table audit_settings {
  attribute varchar [pk, not null]
  options text [not null, default: '{}']
}

//// Relationships (Prisma defaults: onUpdate Cascade; onDelete SetNull for optional relations, Restrict otherwise)

Ref: agent_hierarchy.parent_agent_type > agent_settings.agent_type [delete: cascade, update: cascade]
Ref: agent_hierarchy.child_agent_type > agent_settings.agent_type [delete: cascade, update: cascade]
Ref: ai_model.ai_provider_id > ai_provider.id [delete: restrict, update: cascade]
Ref: ai_credential.ai_provider_id > ai_provider.id [delete: restrict, update: cascade]
Ref: agent_settings.ai_credential_id > ai_credential.id [delete: restrict, update: cascade]
Ref: agent_settings.ai_model_id > ai_model.id [delete: restrict, update: cascade]
Ref: project_version.project_id > project.id [delete: restrict, update: cascade]
Ref: evaluation.project_version_id > project_version.id [delete: restrict, update: cascade]
Ref: agent_execution.evaluation_id > evaluation.id [delete: set null, update: cascade]
Ref: agent_execution.agent_type > agent_settings.agent_type [delete: restrict, update: cascade]
Ref: project.selected_version_id - project_version.id [delete: set null, update: cascade]
Ref: task.project_id > project.id [delete: restrict, update: cascade]
