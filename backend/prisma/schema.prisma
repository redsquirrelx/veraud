// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id                 Int            @id @default(autoincrement())
  name               String?
  createdAt          DateTime       @default(now()) @map("created_at")
  lastSyncedAt       DateTime?      @map("last_synced_at")
  status             String
  githubRepositoryId BigInt?        @unique @map("github_repository_id")
  cloneProtocol      String         @default("https") @map("clone_protocol")
  shallowClone       Boolean        @default(false) @map("shallow_clone")
  repositoryOwner    String         @map("repository_owner")
  repositoryName     String         @map("repository_name")
  selectedVersionId  Int?           @unique @map("selected_version_id")

  selectedVersion ProjectVersion?  @relation("ProjectSelectedVersion", fields: [selectedVersionId], references: [id])
  versions        ProjectVersion[] @relation("ProjectVersions")
  tasks           Task[]

  @@unique([repositoryOwner, repositoryName])
  @@map("project")
}

model ProjectVersion {
  id             Int       @id @default(autoincrement())
  projectId      Int       @map("project_id")
  branch         String?
  commitHash     String?   @map("commit_hash")
  analysisStatus String    @map("analysis_status")
  analyzedAt     DateTime? @map("analyzed_at")

  project     Project      @relation("ProjectVersions", fields: [projectId], references: [id])
  selectedBy  Project?     @relation("ProjectSelectedVersion")
  evaluations Evaluation[]

  @@unique([projectId, commitHash])
  @@map("project_version")
}

model Evaluation {
  id               Int       @id @default(autoincrement())
  projectVersionId Int       @map("project_version_id")
  type             String
  createdAt        DateTime  @default(now()) @map("created_at")
  startedAt        DateTime? @map("started_at")
  finishedAt       DateTime? @map("finished_at")

  projectVersion  ProjectVersion   @relation(fields: [projectVersionId], references: [id])
  agentExecutions AgentExecution[]

  @@map("evaluation")
}

model AgentExecution {
  id           Int       @id @default(autoincrement())
  evaluationId Int?      @map("evaluation_id")
  agentType    String    @map("agent_type")
  status       String
  createdAt    DateTime  @default(now()) @map("created_at")
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  inputTokens  Int?      @map("input_tokens")
  outputTokens Int?      @map("output_tokens")
  estimatedTokens Int?  @map("estimated_tokens")
  interruptionReason String? @map("interruption_reason")
  error        String?
  result       String?
  configurationSnapshot String? @map("configuration_snapshot")

  evaluation    Evaluation?   @relation(fields: [evaluationId], references: [id])
  agentSettings AgentSettings @relation(fields: [agentType], references: [agentType])

  @@map("agent_execution")
}

model AiProvider {
  id   Int    @id @default(autoincrement())
  name String

  models      AiModel[]
  credentials AiCredential[]

  @@map("ai_provider")
}

model AiCredential {
  id           Int    @id @default(autoincrement())
  aiProviderId Int    @map("ai_provider_id")
  name         String
  apiKey       String @map("api_key")
  revision     Int    @default(1)

  aiProvider     AiProvider     @relation(fields: [aiProviderId], references: [id])
  agentSettings AgentSettings[]

  @@map("ai_credential")
}

model AiModel {
  id           Int    @id @default(autoincrement())
  aiProviderId Int    @map("ai_provider_id")
  name         String
  revision     Int    @default(1)

  aiProvider    AiProvider     @relation(fields: [aiProviderId], references: [id])
  agentSettings AgentSettings[]

  @@map("ai_model")
}

model AgentSettings {
  agentType      String @id @map("agent_type")
  catalogDeclared Boolean @default(false) @map("catalog_declared")
  catalogName String? @map("catalog_name")
  catalogRole String? @map("catalog_role")
  requiresModel Boolean @default(false) @map("requires_model")
  modelConfigurationAgentType String? @map("model_configuration_agent_type")
  executionModes String @default("[]") @map("execution_modes")
  availability String @default("not_executed")
  aiModelId      Int?   @map("ai_model_id")
  aiCredentialId Int?   @map("ai_credential_id")
  temperature    Decimal?
  maxTokens      Int?    @map("max_tokens")
  tokenBudget    Int?    @map("token_budget")
  absoluteTokenLimit Int? @map("absolute_token_limit")
  verificationFingerprint String? @map("verification_fingerprint")
  verificationCheckedAt DateTime? @map("verification_checked_at")
  verificationError String? @map("verification_error")

  aiModel         AiModel?         @relation(fields: [aiModelId], references: [id], onDelete: Restrict)
  aiCredential    AiCredential?    @relation(fields: [aiCredentialId], references: [id], onDelete: Restrict)
  agentExecutions AgentExecution[]
  childLinks AgentHierarchy[] @relation("AgentParent")
  parentLinks AgentHierarchy[] @relation("AgentChild")

  @@map("agent_settings")
}

model AgentHierarchy {
  parentAgentType String @map("parent_agent_type")
  childAgentType String @map("child_agent_type")
  parent AgentSettings @relation("AgentParent", fields: [parentAgentType], references: [agentType], onDelete: Cascade, onUpdate: Cascade)
  child AgentSettings @relation("AgentChild", fields: [childAgentType], references: [agentType], onDelete: Cascade, onUpdate: Cascade)

  @@id([parentAgentType, childAgentType])
  @@index([childAgentType])
  @@map("agent_hierarchy")
}

model Task {
  id          Int    @id @default(autoincrement())
  projectId   Int    @map("project_id")
  description String?
  command     String?
  status      String
  kind        String @default("unknown")
  exitCode    Int?   @map("exit_code")
  logTrail    String? @map("log_trail")

  project Project @relation(fields: [projectId], references: [id])

  @@map("task")
}
