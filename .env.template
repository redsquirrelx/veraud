PORT_FRONTEND       = 7500
PORT_BACKEND        = 7501
PORT_AGENTSERVER    = 7502

DATABASE_URL        = file:../appdata/database.db

# Optional. Checkout root shared with the agent-server. Empty means the repo
# appdata/workspace next to DATABASE_URL; set it only to relocate checkouts.
# WORKSPACE_DIR       = C:/data/veraud-workspace

# Test-only. The agent-server answers project-architecture runs with offline
# smoke models (same graphs and snapshots, no provider credentials or network)
# for live end-to-end tests. Never set in production.
# AGENT_SERVER_SMOKE_MODELS = 1

# Optional. Traces agent runs to LangSmith: the graph, each node, each model
# call. Without a key nothing is traced and nothing changes. The server loads
# this file itself, so putting the key here is enough. See
# docs/agent-server/tracing.md
# LANGSMITH_API_KEY    = lsv2_pt_...
# LANGSMITH_PROJECT    = agent-server
# LANGSMITH_ENDPOINT   = https://api.smith.langchain.com   # self-hosted if changed